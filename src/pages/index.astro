---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPeriod } from '../lib/formatPeriod';
import { groupSkills } from '../lib/group-skills';
import { buildPersonJsonLd } from '../lib/person-json-ld';
import { type ContactDetails, parsePrintOptions } from '../lib/print-options';
import type { SkillLevel } from '../lib/skill';
import { sortGroups } from '../lib/sort-groups';
import { sortSkills } from '../lib/sort-skills';
import { siteConfig } from '../site.config';
import IndexTemplate from '../templates/IndexTemplate.astro';

const printOptions = parsePrintOptions(__PRINT_OPTIONS__);

// The hero intro defaults to the site config tagline; a print build can swap in
// a different pitch (e.g. an agency that wants its own CV intro).
const hero = {
  name: siteConfig.firstName,
  tagline: printOptions?.heroTagline ?? siteConfig.tagline,
  recipientName: siteConfig.fullName,
  availableFrom: siteConfig.availableFrom,
};

const coordinates: ContactDetails = {
  email: printOptions?.email,
  phone: printOptions?.phone,
  location: siteConfig.location,
  website: siteConfig.links.website,
  github: siteConfig.links.github,
  linkedin: siteConfig.links.linkedin,
};

// "All skills" defaults to every skill; the local print build can raise the
// floor (e.g. 3) to drop low-level entries from the CV. Key skills are a
// hand-picked highlight reel and stay untouched.
const minSkillLevel = printOptions?.minSkillLevel ?? 1;

// Each role's stack/domains skills truncate on paper like on screen; the print
// build can opt to expand either list in full instead, independently.
const allStackSkills = printOptions?.allStackSkills ?? false;
const allDomainSkills = printOptions?.allDomainSkills ?? false;
const profilePhoto = printOptions?.profilePhoto ?? true;

type VisibleSkill = {
  id: string;
  name: string;
  level: SkillLevel;
  years: number;
  group: string;
  children?: string[];
};

const groupOrder = (await getCollection('skillGroups'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data.name);

const allSkills: VisibleSkill[] = (await getCollection('skills'))
  .filter((entry) => !entry.data.hide)
  .map((entry) => ({
    id: entry.id,
    name: entry.data.name,
    level: entry.data.level as SkillLevel,
    years: entry.data.years as number,
    group: entry.data.group as string,
    children: entry.data.children as string[] | undefined,
  }));

const skillByName = new Map(allSkills.map((skill) => [skill.name, skill]));
const keySkills = (await getCollection('keySkills'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => skillByName.get(entry.data.name))
  .filter((skill): skill is VisibleSkill => skill !== undefined)
  .map(({ id, name, level, years }) => ({ id, name, level, years }));

const skillGroups = sortGroups(
  groupSkills(allSkills.filter((skill) => skill.level >= minSkillLevel)).map(
    ({ group, items }) => ({
      group,
      skills: sortSkills(items).map(({ id, name, level, years }) => ({ id, name, level, years })),
    }),
  ),
  groupOrder,
);

const experienceEntries = (await getCollection('experience')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

const STACK_LIMIT = 20;
const DOMAINS_LIMIT = 20;

const experience = experienceEntries.map((entry) => ({
  id: entry.id,
  role: entry.data.role,
  meta: entry.data.meta,
  period: formatPeriod(entry.data.start, entry.data.end),
  description: entry.data.description,
  stack: entry.data.technologies.slice(0, STACK_LIMIT),
  domains: (entry.data.concepts ?? []).slice(0, DOMAINS_LIMIT),
}));

const jsonLd = buildPersonJsonLd(
  siteConfig,
  experienceEntries.map((entry) => ({
    meta: entry.data.meta,
    role: entry.data.role,
    start: entry.data.start,
    end: entry.data.end,
  })),
  new URL('/', Astro.site).toString(),
  allSkills.filter((skill) => skill.level >= 3).map(({ name, children }) => ({ name, children })),
  new URL('/profile.jpg', Astro.site).toString(),
);
---

<BaseLayout jsonLd={jsonLd}>
  <IndexTemplate
    hero={hero}
    keySkills={keySkills}
    experience={experience}
    skillGroups={skillGroups}
    languages={siteConfig.languages}
    coordinates={coordinates}
    allStackSkills={allStackSkills}
    allDomainSkills={allDomainSkills}
    profilePhoto={profilePhoto}
  />
</BaseLayout>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest('a[href^="#"]');
    if (!(link instanceof HTMLAnchorElement)) return;
    const id = link.getAttribute('href')?.slice(1);
    if (!id) return;
    const section = document.getElementById(id);
    if (!section) return;
    event.preventDefault();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    section.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth' });
  });
</script>
