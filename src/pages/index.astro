---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import IndexTemplate from '../templates/IndexTemplate.astro';

const hero = {
  name: siteConfig.firstName,
  available: siteConfig.hero.available,
  ctaHref: `mailto:${siteConfig.email}`,
};

const allSkills = await getCollection('skills');
const keySkills = allSkills
  .filter((entry) => entry.data.keySkill)
  .map((entry) => ({
    id: entry.id,
    name: entry.data.name,
    level: entry.data.level,
    years: entry.data.years,
  }));

const work = (await getCollection('work'))
  .sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
  .map((entry) => ({
    id: entry.id,
    role: entry.data.role,
    meta: entry.data.meta,
    period: entry.data.period,
    description: entry.data.description,
    stack: entry.data.stack,
    methods: entry.data.methods,
  }));
---

<BaseLayout>
  <IndexTemplate hero={hero} keySkills={keySkills} work={work} />
</BaseLayout>
