---
import { ContactCta } from "../components/ContactCta/ContactCta";
import {
  Experience,
  type ExperienceEntry,
} from "../components/Experience/Experience";
import { Hero } from "../components/Hero/Hero";
import { type KeySkill, KeySkills } from "../components/KeySkills/KeySkills";
import {
  type Language,
  Miscellaneous,
} from "../components/Miscellaneous/Miscellaneous";
import {
  type SkillGroup,
  SkillGroups,
} from "../components/SkillGroups/SkillGroups";

interface Props {
  hero: {
    name: string;
    recipientName: string;
    availableFrom?: Date;
  };
  keySkills: KeySkill[];
  experience: ExperienceEntry[];
  skillGroups: SkillGroup[];
  languages: Language[];
}

const { hero, keySkills, experience, skillGroups, languages } = Astro.props;
---

<main>
  <section>
    <Hero name={hero.name}>
      <ContactCta
        recipientName={hero.recipientName}
        availableFrom={hero.availableFrom}
        client:load
      />
    </Hero>
  </section>
  <section id="key-skills" aria-labelledby="key-skills-heading">
    <KeySkills skills={keySkills} />
  </section>
  <section id="experience" aria-labelledby="experience-heading">
    <Experience entries={experience} client:visible />
  </section>
  <section id="skills" aria-labelledby="skills-heading">
    <SkillGroups groups={skillGroups} client:visible />
  </section>
  <section id="miscellaneous" aria-labelledby="miscellaneous-heading">
    <Miscellaneous languages={languages} />
  </section>
  <slot />
</main>

<style>
  main {
    box-sizing: border-box;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 64px var(--container-padding) 100px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  @media print {
    main {
      padding: 0;
    }
  }
</style>
