---
import { Coordinates, type CoordinatesProps } from '../components/organisms/Coordinates';
import { Experience, type ExperienceEntry } from '../components/organisms/Experience';
import { Hero } from '../components/organisms/Hero';
import { type KeySkill, KeySkills } from '../components/organisms/KeySkills';
import { type Language, Miscellaneous } from '../components/organisms/Miscellaneous';
import { type SkillGroup, SkillGroups } from '../components/organisms/SkillGroups';
import { ContactContainer } from '../containers';

interface Props {
  hero: {
    name: string;
    tagline: string;
    recipientName: string;
    availableFrom?: Date;
  };
  keySkills: KeySkill[];
  experience: ExperienceEntry[];
  skillGroups: SkillGroup[];
  languages: Language[];
  coordinates: CoordinatesProps;
  /** Print build only: expand each role's stack skills in full (see Experience). */
  allStackSkills?: boolean;
  /** Print build only: expand each role's methods skills in full (see Experience). */
  allMethodSkills?: boolean;
}

const {
  hero,
  keySkills,
  experience,
  skillGroups,
  languages,
  coordinates,
  allStackSkills = false,
  allMethodSkills = false,
} = Astro.props;
---

<main>
  <section>
    <Hero name={hero.name} tagline={hero.tagline}>
      <ContactContainer
        recipientName={hero.recipientName}
        availableFrom={hero.availableFrom}
        client:load
      />
    </Hero>
  </section>
  <section id="key-skills" aria-labelledby="key-skills-heading">
    <KeySkills skills={keySkills} allSkillsHref="#skills" />
  </section>
  <section id="experience" aria-labelledby="experience-heading">
    <Experience
      entries={experience}
      allStackSkills={allStackSkills}
      allMethodSkills={allMethodSkills}
      client:visible
    />
  </section>
  <section id="skills" aria-labelledby="skills-heading">
    <SkillGroups groups={skillGroups} client:visible />
  </section>
  <section id="miscellaneous" aria-labelledby="miscellaneous-heading">
    <Miscellaneous languages={languages} />
  </section>
  <Coordinates {...coordinates} />
  <slot />
</main>

<style>
  main {
    box-sizing: border-box;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 64px var(--container-padding) 100px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  @media print {
    main {
      /* Let the content fill the printable area so the @page margin alone sets
         the edge whitespace, rather than the 700px cap fighting it. A small
         symmetric gutter keeps the right-aligned level-meter dots off the very
         edge, where the renderer would otherwise clip the outermost one. */
      max-width: none;
      padding: 0 var(--space-2);
      /* The 72px web rhythm between sections is far too airy on paper. */
      gap: 28px;
    }
  }
</style>
