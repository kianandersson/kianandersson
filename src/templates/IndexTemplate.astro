---
import { Experience, type ExperienceEntry } from '../components/Experience/Experience';
import { Hero, type HeroProps } from '../components/Hero/Hero';
import { type KeySkill, KeySkills } from '../components/KeySkills/KeySkills';
import { type SkillGroup, SkillGroups } from '../components/SkillGroups/SkillGroups';

interface Props {
  hero: HeroProps;
  keySkills: KeySkill[];
  experience: ExperienceEntry[];
  skillGroups: SkillGroup[];
}

const { hero, keySkills, experience, skillGroups } = Astro.props;
---

<main>
  <section><Hero {...hero} /></section>
  <section aria-labelledby="key-skills-heading">
    <KeySkills skills={keySkills} />
  </section>
  <section aria-labelledby="experience-heading">
    <Experience entries={experience} client:visible />
  </section>
  <section id="skills" aria-labelledby="skills-heading">
    <SkillGroups groups={skillGroups} client:visible />
  </section>
  <slot />
</main>

<style>
  main {
    box-sizing: border-box;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 64px var(--container-pad) 100px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      main > section:not(:first-child) {
        animation: scroll-reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }

      @keyframes scroll-reveal {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

  @media print {
    main {
      display: block;
      padding: 0;
    }

    section:not(:first-of-type) {
      margin-block-start: 72px;
    }
  }
</style>
