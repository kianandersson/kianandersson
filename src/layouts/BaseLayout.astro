---
import { Footer } from '../components/organisms/Footer';
import { SiteHeader } from '../components/organisms/SiteHeader';
import { OG_IMAGE_SIZE } from '../lib/og';
import { buildPersonJsonLd, type PersonJsonLd } from '../lib/person-json-ld';
import { siteConfig } from '../site.config';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: PersonJsonLd;
  showPrint?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = `${siteConfig.fullName}, ${siteConfig.role} based in ${siteConfig.location}.`,
  jsonLd,
  showPrint = true,
} = Astro.props;

// The OG image always depicts the person, regardless of the page title, so its
// alt text stays fixed rather than tracking `title`.
const ogImageAlt = siteConfig.defaultTitle;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();

const personJsonLd =
  jsonLd ?? buildPersonJsonLd(siteConfig, [], Astro.site?.toString() ?? canonical);

const jsonLdSerialized = JSON.stringify(personJsonLd).replace(/</g, '\\u003c');

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={siteConfig.fullName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:profile:first_name" content={siteConfig.firstName} />
    <meta property="og:profile:last_name" content={siteConfig.lastName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="preload"
      href="/fonts/Geist.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistMono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
            return;
          }
        } catch (e) {}
        var prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={jsonLdSerialized} />
  </head>
  <body>
    <SiteHeader
      githubHref={siteConfig.links.github}
      showPrint={showPrint}
      client:load
    />
    <slot />
    <Footer
      name={siteConfig.fullName}
      year={currentYear}
      sourceHref={siteConfig.links.source}
    />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--color-surface);
    color: var(--color-text);
    line-height: var(--text-body-leading);
    min-height: 100vh;
    transition:
      background 0.4s ease,
      color 0.4s ease;
  }

  ::selection {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    body {
      transition: none;
    }
  }

  @page {
    size: A4;
    /* 1cm keeps the 700px container inside A4's printable width (~718px at 1cm)
       so nothing clips at the edges. */
    margin: 1cm;
  }
</style>
