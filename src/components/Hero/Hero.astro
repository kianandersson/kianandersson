---
interface Props {
  name: string;
}

const { name } = Astro.props;

const PLACEHOLDER_BODY =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.';
---

<div class="root">
  <div class="text">
    <h1 class="heading">
      Hi, I'm <span class="name">{name}</span>.
    </h1>
    <p class="body">{PLACEHOLDER_BODY}</p>
  </div>
  <slot />
</div>

<style>
  .root {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .heading {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-display-xl-size);
    line-height: var(--text-display-xl-leading);
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0;
  }

  .name {
    color: var(--color-accent);
  }

  .body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-heading-s-size);
    line-height: var(--text-heading-s-leading);
    color: var(--color-text-muted);
    max-width: 540px;
  }
</style>
