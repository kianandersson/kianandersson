{
  "name": "kianandersson",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:components": "vitest run --project=storybook",
    "test:coverage": "vitest run --project=storybook --coverage",
    "test:watch": "vitest",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:bundle",
    "storybook": "storybook dev -p 6006",
    "print": "node scripts/print.ts",
    "signature": "node scripts/signature.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/preact": "^6.0.1",
    "astro": "^7.0.6",
    "preact": "^10.29.2",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.16",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/preact-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "devalue": "^5.8.1",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "jsdom": "^29.1.1",
    "preact-render-to-string": "^6.7.0",
    "sharp": "^0.34.5",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
