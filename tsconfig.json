{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["@testing-library/jest-dom"],
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime/"]
    }
  },
  "exclude": [
    "dist",
    "node_modules",
    "design",
    "docs",
    "scripts",
    "playwright-report",
    "test-results"
  ]
}
