# Copy to .env for local development. All three are required for the contact
# action to send mail; if any are missing the action returns an error.

# Resend API key.
RESEND_API_KEY=

# Verified sender for the contact form, e.g. "Contact <noreply@example.com>".
CONTACT_FROM=

# Inbox that contact-form messages are delivered to.
CONTACT_TO=
